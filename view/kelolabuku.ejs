<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

<div class="container mt-5">
    <h1 class="text-center mb-4">Kelola Buku Perpustakaan</h1>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 id="form-title" class="card-title">Tambah Buku Baru</h5>
            <form id="bookForm">
                <input type="hidden" id="bookId">
                <div class="form-row">
                    <div class="form-group col-md-5">
                        <input type="text" class="form-control" id="namabuku" placeholder="Nama Buku" required autofocus>
                    </div>
                    <div class="form-group col-md-5">
                        <input type="text" class="form-control" id="jenisbuku" placeholder="Jenis Buku" required>
                    </div>
                    <div class="form-group col-md-2">
                        <button type="submit" class="btn btn-primary btn-block">Simpan</button>
                        <button type="button" id="cancelBtn" class="btn btn-secondary btn-block mt-2 d-none">Batal</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Daftar Buku</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>No</th>
                            <th>Nama Buku</th>
                            <th>Jenis Buku</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="book-list-body">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <a href="/" class="btn btn-outline-primary mt-4">Kembali ke Home</a>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>


<script>
  $(document).ready(function () {
    function refreshBookList() {
      $.get("/perpustakaan", function (books) {
        const bookListBody = $("#book-list-body").empty(); 
        if (books.length > 0) {
          books.forEach((book, index) => {
            bookListBody.append(`
              <tr>
                <td>${index + 1}</td>
                <td>${book.namabuku}</td>
                <td>${book.jenisbuku}</td>
                <td>
                  <button class="btn btn-sm btn-warning editBtn" data-id="${book.id}" data-namabuku="${book.namabuku}" data-jenisbuku="${book.jenisbuku}">Edit</button>
                  <button class="btn btn-sm btn-danger deleteBtn" data-id="${book.id}">Hapus</button>
                </td>
              </tr>
            `);
          });
        } else {
          bookListBody.append('<tr><td colspan="4" class="text-center">Tidak ada data buku.</td></tr>');
        }
      });
    }

    $("#bookForm").on("submit", function (e) {
      e.preventDefault();
      const id = $("#bookId").val();
      const url = id ? `/perpustakaan/${id}` : '/perpustakaan';
      const type = id ? 'PUT' : 'POST';
      
      const bookData = {
        namabuku: $("#namabuku").val().trim(),
        jenisbuku: $("#jenisbuku").val().trim(),
      };

      $.ajax({
        url: url,
        type: type,
        contentType: "application/json",
        data: JSON.stringify(bookData),
        success: () => location.reload(), 
        error: () => alert('Gagal menyimpan buku.'),
      });
    });

    $("#book-list-body").on("click", ".editBtn", function () {
      $("#bookId").val($(this).data("id"));
      $("#namabuku").val($(this).data("namabuku"));
      $("#jenisbuku").val($(this).data("jenisbuku"));
      $("#form-title").text('Edit Buku');
      $("#cancelBtn").removeClass('d-none');
      window.scrollTo(0, 0);
    });
    
    $("#book-list-body").on("click", ".deleteBtn", function () {
      if (confirm('Yakin hapus buku ini?')) {
        $.ajax({
          url: `/perpustakaan/${$(this).data("id")}`,
          type: "DELETE",
          success: () => location.reload(), 
          error: () => alert('Gagal menghapus buku.'),
        });
      }
    });

    $("#cancelBtn").on("click", function() {
      $("#bookForm")[0].reset();
      $("#bookId").val('');
      $("#form-title").text('Tambah Buku Baru');
      $(this).addClass('d-none');
    });
    refreshBookList();
  });
</script>

